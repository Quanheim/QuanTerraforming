<Project Sdk="Microsoft.NET.Sdk">
  <!-- Framework, references, deploy and packaging come from Directory.Build.props/.targets. -->
  <PropertyGroup>
    <AssemblyName>QuanTerraforming</AssemblyName>
    <RootNamespace>QuanTerraforming</RootNamespace>

    <!-- The ONLY place to bump the version: feeds the plugin attribute and the generated manifest.json -->
    <Version>1.0.0</Version>

    <!-- Thunderstore manifest description: max 250 characters, no double quotes. -->
    <ThunderstoreDescription>Terraforming fix and overlay: sea waves follow your terrain edits instead of the original seabed, so raised coasts, canals and harbours stay calm. Includes a zone (chunk) grid showing the corner depths that set wave height.</ThunderstoreDescription>
    <!-- Becomes website_url in manifest.json: the Thunderstore page's link to the repo (and its Issues).
         Leave empty to use this repo's git remote automatically; set it only to point somewhere else. -->
    <RepoUrl></RepoUrl>
  </PropertyGroup>

  <!-- Extra Unity modules this mod uses: IMGUI for the on-screen box. -->
  <ItemGroup>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(ManagedDir)\UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(ManagedDir)\UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
